#!/bin/sh

pidarg() {
    xargs -0 -a /proc/$1/cmdline sh -c 'echo $'"$2" -- 2>/dev/null
}

pidopt() {
    xargs -0 -a /proc/$1/cmdline sh -c "shift; getopt '$2'"'"$@"' -- 2>/dev/null
}

for pid in $(pidof "$(pidarg $$ 0)" | tr ' ' '\n' | grep -v $$); do
    if [ "$(pidarg $pid 1)" = "$0" ]; then
	oldname="$name"
	if ( parseargs $(pidopt $pid "n:i:w:"); [ "$name" = "$oldname" ]; ); then
	    #kill -USR1 $pid
	    #exit 0
	fi
    fi
done
