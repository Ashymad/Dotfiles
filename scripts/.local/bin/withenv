#!/bin/sh
set -e

ENVFILE="-"
TAC="tac"
which tac >/dev/null 2>&1 && TAC="tac" || TAC="tail -r"

while :; do
    case $1 in
        -e|--export) EXPORT=1; shift ;;
        -i|--ignore) IGNORE=1; shift ;;
        -f|--file)   ENVFILE="$2"; shift 2 ;;
        --) break ;;
        -*) echo "Invalid option $1"; exit 1 ;;
        *) break ;;
    esac
done

subst() {
    cat "$1" \
      | { tee /dev/fd/3 \
        | sha1sum \
        | awk '{print "\n_ENV_SHA1SUM=" $1}'; \
        } 3>&1 \
      | $TAC \
      | xargs sh -c 'printf "%s\n" "${@}" | '"$TAC"' | env '$ENVARGS' "$0" envsubst' --
}

apparg() {
    tr '\n' '\0'
    [ "$#" -gt 0 ] && printf "%s\0" "$@"
}

if [ "$IGNORE" = 1 ]; then
    ENVARGS="-i"
fi

if [ "$EXPORT" = 1 ]; then
    subst "$ENVFILE" | sed 's/^\([^=]*\)=\(.*\)$/export \1="\2"/'
    exit 0
fi

exec xargs -0 -a $(subst "$ENVFILE" | apparg "$@" | PATH=$PATH:~/.local/bin tofifo) env $ENVARGS
