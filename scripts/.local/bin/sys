#!/bin/sh

cmd="$1"
shift

has() {
    exec which "$1" >/dev/null 2>&1
}

has systemctl && ctlcmd=systemctl || ctlcmd=loginctl

if [ $UID -ne 0 ]; then
    if has doas; then
	sudo=doas
    else
	sudo=sudo
    fi
fi

case $cmd in
    lock)
        swaylock $(awww query --json | jq -r '."".[] | ("-i\n" + .name + ":" + .displaying.image)') -s fill
        ;;
    reboot)
        $sudo $ctlcmd reboot
        ;;
    suspend)
        $sudo $ctlcmd suspend
        ;;
    poweroff)
        $sudo $ctlcmd poweroff
        ;;
    update)
	if has apk; then
	    $sudo apk update "$@"
	elif has apt; then
	    $sudo apt update "$@"
	elif has nix; then
	    nix flake update --flake ~/.config/nixos "$@"
	else
	    echo "Unsupported system"
	fi
	;;
    upgrade)
	if has apk; then
	    $sudo apk upgrade "$@"
	elif has apt; then
	    $sudo apt upgrade "$@"
	elif has nixos-rebuild; then
	    nixos-rebuild switch ${sudo:+--sudo} --flake ~/.config/nixos "$@"
	else
	    echo "Unsupported system"
	fi
	;;
    *)
        echo "Unknown command: '$1'"
        exit 1
        ;;
esac
