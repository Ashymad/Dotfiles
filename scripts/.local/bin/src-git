#!/bin/sh

disp() {
    tr '\n' '\0' | xargs -0 -I '{}' printf "\x1b[2K%-25s %.60s\r" "$1" '{}'
}

for dir in ~/.usr/src/*; do
    [ -d "$dir"/.git ] || continue

    if git -C "$dir" symbolic-ref -q HEAD >/dev/null; then
        [ "$1" = "-u" ] && git -C "$dir" remote -v update 2>&1 | disp "$(basename $dir)"
        branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD)"
        if [ "$branch" = "HEAD" ]; then
            echo "No branch or tag found for $pkg"
            exit 1
        fi
        if remote="$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)"; then
            commits="$(git -C "$dir" rev-list --left-only --count "$remote...@")"
            if [ "$commits" != 0 ]; then
                /usr/bin/printf "\x1b[2K%-25s %15s ++ %s\n" "$(basename $dir)" "$branch" "$commits"
            fi
        fi
    else
        tag="$(git -C "$dir" describe --exact-match --tags)"
        [ "$1" = "-u" ] && git -C "$dir" fetch -v --tags 2>&1 | disp "$(basename $dir)"
        remote_tag="$(git -C "$dir" for-each-ref --sort=creatordate --format '%(refname)' refs/tags | cut -d/ -f3 | tail -1)"
        if [ "${tag#v}" != "${remote_tag#v}" ]; then
            /usr/bin/printf "\x1b[2K%-25s %15s -> %s\n" "$(basename $dir)" "$tag" "$remote_tag"
        fi
    fi
done
