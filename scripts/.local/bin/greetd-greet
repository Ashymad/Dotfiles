#!/bin/sh

H="$(readlink -f $(dirname "$0")/../..)"
U="$(awk "-vH=$H" -F: '{if ($6 == H) print $1}' /etc/passwd)"
E="$H/.global/env"
S="$H/.dotfiles/sway/.local/share/wayland-sessions"

fbterm_bi() {
    tput civis
    "${fbv}" -ciukery "$1"
    shift
    export FBTERM_BACKGROUND_IMAGE=1
    exec "${fbterm}" "$@"
}

export withenv="$H/.local/bin/withenv"

printf "[    ]\r["
for bin in fbterm fbv awww tuigreet; do
    bin_path="$(env HOME="$H" "${withenv}" -f "$E" which $bin 2>/dev/null)"
    [ -z "$bin_path" ] && {
	printf "!"
    } || {
        printf "#"
        export ${bin}="$bin_path"
    }
done
printf "]\n"

if [ -z "${tuigreet}" ]; then
    echo "Tuigreet not found, starting agreety"
    exec agreety --cmd "${withenv} -f $E sway"
elif [ -z "${fbterm}" ]; then
    echo "Fbterm not found, starting in TTY"
    exec "${tuigreet}" -u "$U" --asterisks -s "$S"
elif [ -z "${awww}" ] || [ -z "${fbv}" ]; then
    echo "Fbv or awww not found, not setting background"
    exec "${fbterm}" -- "${tuigreet}" -u "$U" --asterisks -s "$S"
else
    P="$(xargs -a "$H/.cache/awww/$("${awww}" --version | cut -d' ' -f2)"/* -0 sh -c 'echo "$3"' 0)"
    fbterm_bi "$P" -- "${tuigreet}" -u "$U" --asterisks -s "$S"
fi

