#!/bin/sh

while true; do
    case $1 in
	-n) name="$2"; shift 2;;
	-w) wait="$2"; shift 2;;
	-h) echo "Usage: $0 [ -n <name> ] [ -w <time> ] -- args ..."; exit 0;;
	--) shift 1; break;;
	*) break;;
    esac
done

[ -z "$name" ] && name="$(uuidgen)"
[ -z "$wait" ] && wait=1
[ $# -eq 0 ] && set -- echo '{}'

sleep "$wait" &
trap "kill $!" USR1
wait $! || true

teed $PPID | head -1 | xargs -I'{}' "$@"

exec $0 -n $name -w $wait -- "$@" < $(tofifo awk 'NR==1{F=$0}NR>1{print}END{print F}' $(tofifo teed $PPID))
